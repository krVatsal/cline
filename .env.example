# TrueForge / TrueFoundry Configuration (Optional)
# If omitted, Cline defaults to http://localhost:8790 and automatically
# resolves the active model registered in TrueForge.

# TrueForge Server URL (default: http://localhost:8790)
TRUEFORGE_BASE_URL=http://localhost:8790

# Model Override (optional: leave empty to auto-detect from TrueForge)
# Examples:
# TRUEFORGE_MODEL=groq/llama-3-1-8b-instant
# TRUEFORGE_MODEL=google-gemini/gemini-2-0-flash

# TrueFoundry Cloud API Key (only needed if using TrueFoundry Cloud instead of local TrueForge)
# TFY_API_KEY=your-truefoundry-api-key
